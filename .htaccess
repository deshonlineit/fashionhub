# FashionHub performance defaults for Apache/XAMPP/shared hosting.
# Every rule is guarded so unsupported modules do not break the site.

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical redirects from legacy query-string URLs to public clean URLs.
  # THE_REQUEST is used so internal rewrites never redirect back out.
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*product\.html\?id=([0-9]+) [NC]
  RewriteRule ^product\.html$ product-p%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*category\.html\?cat=([^&\s]+) [NC]
  RewriteRule ^category\.html$ category-%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*search\.html\?q=([^&\s]+) [NC]
  RewriteRule ^search\.html$ search-%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*post\.html\?post=([0-9]+) [NC]
  RewriteRule ^post\.html$ blog-post-%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*shop\.html\?sort=new(?:[&\s]) [NC]
  RewriteRule ^shop\.html$ new-arrivals [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*archive\.html\?type=deals(?:[&\s]) [NC]
  RewriteRule ^archive\.html$ deals [R=301,L,NE,QSD]

  # Remove index.html and all other public .html extensions.
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ ./ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*[a-z0-9-]+\.html(?:[?\s]) [NC]
  RewriteRule ^([a-z0-9-]+)\.html$ $1 [R=301,L,NE,QSD]

  # Clean route URLs are file-like (no trailing slash) so relative assets stay rooted correctly.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1 [R=301,L,NE]

  # SEO-friendly public routes. Query values exist only inside Apache and never appear in the browser URL.
  RewriteRule ^product-(?:[a-z0-9-]+-)?p([0-9]+)$ product.html?id=$1 [L,QSA,NC]
  RewriteRule ^category-([a-z0-9-]+)$ category.html?cat=$1 [L,QSA,NC]
  RewriteRule ^search-([a-z0-9-]+)$ search.html?q=$1 [L,QSA,NC]
  RewriteRule ^blog-(?:[a-z0-9-]+-)?p([0-9]+)$ post.html?post=$1 [L,QSA,NC]
  RewriteRule ^blog-post-([0-9]+)$ post.html?post=$1 [L,QSA,NC]
  RewriteRule ^new-arrivals$ shop.html?sort=new [L,QSA,NC]
  RewriteRule ^deals$ archive.html?type=deals [L,QSA,NC]

  # Simple extensionless pages.
  RewriteRule ^shop$ shop.html [L,NC]
  RewriteRule ^blog$ blog.html [L,NC]
  RewriteRule ^cart$ cart.html [L,NC]
  RewriteRule ^checkout$ checkout.html [L,NC]
  RewriteRule ^contact$ contact.html [L,NC]
  RewriteRule ^account$ account.html [L,NC]
  RewriteRule ^wishlist$ wishlist.html [L,NC]
  RewriteRule ^product$ product.html [L,NC]
  RewriteRule ^category$ category.html [L,NC]
  RewriteRule ^search$ search.html [L,NC]
  RewriteRule ^archive$ archive.html [L,NC]
  RewriteRule ^post$ post.html [L,NC]

  # Clean internal API aliases. These keep PHP filenames out of application-facing endpoint URLs.
  RewriteRule ^api/customer/login$ backend-examples/php/checkout-login.php [L,NC]
  RewriteRule ^api/customer/session$ backend-examples/php/customer-session.php [L,NC]
  RewriteRule ^api/customer/register$ backend-examples/php/customer-register.php [L,NC]
  RewriteRule ^api/customer/logout$ backend-examples/php/customer-logout.php [L,NC]
  RewriteRule ^api/customer/profile$ backend-examples/php/customer-profile.php [L,NC]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|jpe?g|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.svg$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header merge Vary "Accept-Encoding"

  # Start shared UI/data downloads immediately while HTML is still arriving.
  <FilesMatch "\.html$">
    Header add Link "<assets/js/config.js>; rel=preload; as=script"
    Header add Link "<data/home-data.js>; rel=preload; as=script"
    Header add Link "<assets/js/category-hover.js>; rel=preload; as=script"
    Header add Link "<assets/js/cart-effects.js>; rel=preload; as=script"
    Header add Link "<assets/css/nav-fix.css>; rel=preload; as=style"
    Header add Link "<assets/css/sticky-header.css>; rel=preload; as=style"
    Header add Link "<assets/css/desktop-category-slider.css>; rel=preload; as=style"
    Header add Link "<assets/css/premium.css>; rel=preload; as=style"
    Header add Link "<assets/css/product-carousel.css>; rel=preload; as=style"
    Header add Link "<assets/css/cart-effects.css>; rel=preload; as=style"
  </FilesMatch>
  <Files "index.html">
    Header add Link "<assets/js/app.js>; rel=preload; as=script"
    Header add Link "<assets/images/banners/hero-fashion.webp>; rel=preload; as=image; fetchpriority=high"
  </Files>
  <FilesMatch "^(?:account|archive|blog|cart|category|checkout|contact|post|product|search|shop|wishlist)\.html$">
    Header add Link "<assets/js/pages.js>; rel=preload; as=script"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>
