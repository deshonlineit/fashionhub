# FashionHub Apache/XAMPP configuration
# Clean public URLs, internal routing, compression and cache defaults.

AddDefaultCharset UTF-8
DirectoryIndex index.html

# Apache content negotiation can steal extensionless routes such as /shop.
# Disable it so mod_rewrite is the only clean-URL router.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Home route. This also keeps the project root working when DirectoryIndex
  # behavior differs between XAMPP and shared hosting.
  RewriteRule ^$ index.html [L]

  # Canonical redirects from old public URLs. THE_REQUEST means these only
  # fire for a URL typed/requested by the browser, never for an internal rewrite.
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*product\.html\?id=([0-9]+) [NC]
  RewriteRule ^product\.html$ product-p%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*category\.html\?cat=([^&\s]+) [NC]
  RewriteRule ^category\.html$ category-%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*search\.html\?q=([^&\s]+) [NC]
  RewriteRule ^search\.html$ search-%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*post\.html\?post=([0-9]+) [NC]
  RewriteRule ^post\.html$ blog-post-%1 [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*shop\.html\?sort=new(?:[&\s]) [NC]
  RewriteRule ^shop\.html$ new-arrivals [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*archive\.html\?type=deals(?:[&\s]) [NC]
  RewriteRule ^archive\.html$ deals [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ ./ [R=301,L,NE,QSD]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*[a-z0-9-]+\.html(?:[?\s]) [NC]
  RewriteRule ^([a-z0-9-]+)\.html$ $1 [R=301,L,NE,QSD]

  # Existing files and real folders must never be routed through the storefront.
  # This protects CSS/JS/images and backend directories from accidental rewrites.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Remove trailing slash only for virtual clean routes. Keeping routes file-like
  # also makes relative assets resolve correctly from a project subdirectory.
  RewriteRule ^(.+)/$ $1 [R=301,L,NE]

  # SEO-friendly public routes. Parameters are internal to Apache only and are
  # never shown in the browser address bar.
  RewriteRule ^product-(?:[a-z0-9-]+-)?p([0-9]+)$ product.html?id=$1 [END,QSA,NC]
  RewriteRule ^category-([a-z0-9-]+)$ category.html?cat=$1 [END,QSA,NC]
  RewriteRule ^search-([a-z0-9-]+)$ search.html?q=$1 [END,QSA,NC]
  RewriteRule ^blog-(?:[a-z0-9-]+-)?p([0-9]+)$ post.html?post=$1 [END,QSA,NC]
  RewriteRule ^blog-post-([0-9]+)$ post.html?post=$1 [END,QSA,NC]
  RewriteRule ^new-arrivals$ shop.html?sort=new [END,QSA,NC]
  RewriteRule ^deals$ archive.html?type=deals [END,QSA,NC]

  # Simple extensionless pages.
  RewriteRule ^shop$ shop.html [END,NC]
  RewriteRule ^blog$ blog.html [END,NC]
  RewriteRule ^cart$ cart.html [END,NC]
  RewriteRule ^checkout$ checkout.html [END,NC]
  RewriteRule ^contact$ contact.html [END,NC]
  RewriteRule ^account$ account.html [END,NC]
  RewriteRule ^wishlist$ wishlist.html [END,NC]
  RewriteRule ^product$ product.html [END,NC]
  RewriteRule ^category$ category.html [END,NC]
  RewriteRule ^search$ search.html [END,NC]
  RewriteRule ^archive$ archive.html [END,NC]
  RewriteRule ^post$ post.html [END,NC]

  # Clean application-facing API aliases. PHP filenames stay internal.
  RewriteRule ^api/customer/login$ backend-examples/php/checkout-login.php [END,NC]
  RewriteRule ^api/customer/session$ backend-examples/php/customer-session.php [END,NC]
  RewriteRule ^api/customer/register$ backend-examples/php/customer-register.php [END,NC]
  RewriteRule ^api/customer/logout$ backend-examples/php/customer-logout.php [END,NC]
  RewriteRule ^api/customer/profile$ backend-examples/php/customer-profile.php [END,NC]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|jpe?g|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.svg$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header merge Vary "Accept-Encoding"

  <FilesMatch "\.html$">
    Header add Link "<assets/js/config.js>; rel=preload; as=script"
    Header add Link "<data/home-data.js>; rel=preload; as=script"
    Header add Link "<assets/js/category-hover.js>; rel=preload; as=script"
    Header add Link "<assets/js/cart-effects.js>; rel=preload; as=script"
    Header add Link "<assets/css/nav-fix.css>; rel=preload; as=style"
    Header add Link "<assets/css/sticky-header.css>; rel=preload; as=style"
    Header add Link "<assets/css/desktop-category-slider.css>; rel=preload; as=style"
    Header add Link "<assets/css/premium.css>; rel=preload; as=style"
    Header add Link "<assets/css/product-carousel.css>; rel=preload; as=style"
    Header add Link "<assets/css/cart-effects.css>; rel=preload; as=style"
  </FilesMatch>
  <Files "index.html">
    Header add Link "<assets/js/app.js>; rel=preload; as=script"
    Header add Link "<assets/images/banners/hero-fashion.webp>; rel=preload; as=image; fetchpriority=high"
  </Files>
  <FilesMatch "^(?:account|archive|blog|cart|category|checkout|contact|post|product|search|shop|wishlist)\.html$">
    Header add Link "<assets/js/pages.js>; rel=preload; as=script"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>
